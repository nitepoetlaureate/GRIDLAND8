# GRIDLAND Environment Variables (TEMPLATE ONLY — safe to commit)
#
# Copy to the project root as .env (NOT config/.env.example):
#   cp config/.env.example .env
# The app loads: .env first, then config/.env (see backend/settings.py).
# Never commit .env — it is gitignored.
# All variables marked [FREE] have free registration tiers.
# All variables marked [NO-AUTH] require no registration.
# Variables marked [V2] are not used in v1 but documented for future use.

# ─── Discovery APIs ───────────────────────────────────────────────────────────

# Mapillary API key [FREE] — https://www.mapillary.com/dashboard → Settings → Developers
# Street-level photospheres: /api/photospheres + auto overlay below 80 m altitude (needs key)
MAPILLARY_API_KEY=

# NPS Developer API key [FREE] — https://www.nps.gov/subjects/developer/get-started.htm
# National park webcam catalog (discovery source nps_webcams)
NPS_API_KEY=

# WSDOT (Washington State DOT) HighwayCameras key [FREE] — wsdot.wa.gov/traffic/api/
WSDOT_API_KEY=

# 511NY (NYSDOT) cameras key [FREE] — https://511ny.org/developers → Register for API key
N511NY_API_KEY=

# 511PA (PennDOT) cameras [FREE, approval] — NOT YET WIRED; request via PennDOT data feed form:
# https://pa.gov/services/penndot/request-access-to-transportation-related-data-feeds.html
# Contact: penndotdata@pa.gov — ~950 PA highway cameras incl. Philly I-95/I-76
# N511PA_API_KEY=

# GreyNoise Community API key [FREE] — Register at greynoise.io/plans/community
GREYNOISE_API_KEY=

# [NO-AUTH] FCC ASR — no key needed
# [NO-AUTH] OSM Overpass — no key needed
# [NO-AUTH] ARIN RDAP — no key needed
# [NO-AUTH] crt.sh — no key needed
# [NO-AUTH] Wayback CDX — no key needed

# [V2] Shodan API key — $49/mo at shodan.io
# SHODAN_API_KEY=

# [V2] Censys API key — free 250 queries/mo at censys.io
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# ─── Real-Time Feeds ──────────────────────────────────────────────────────────

# OpenSky Network — anonymous is 400 req/day. Register free at opensky-network.org
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AISHub research key [FREE] — Register at aishub.net/register
AISHUB_USERNAME=

# aprs.fi API key [FREE] — Register at aprs.fi/page/api
APRS_FI_API_KEY=

# N2YO API key [FREE] — Register at n2yo.com/api/
N2YO_API_KEY=

# [NO-AUTH] ADSB.fi — no key needed
# [NO-AUTH] Celestrak TLEs — no key needed
# [NO-AUTH] Blitzortung (relay required) — no key needed

# ─── Contextual APIs ─────────────────────────────────────────────────────────

# OpenWeatherMap [FREE] — Register at openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# OpenAQ [FREE] — Register at openaq.org
OPENAQ_API_KEY=

# NASA FIRMS fire data [FREE] — Register at firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# Transitland v2 [FREE] — Register at transit.land/api
TRANSITLAND_API_KEY=

# MTA NYC [FREE] — Register at api.mta.info
MTA_API_KEY=

# Mapillary (reuse from discovery)
# MAPILLARY_API_KEY= (set above)

# KartaView [FREE] — Register at kartaview.org
KARTAVIEW_ACCESS_TOKEN=

# [NO-AUTH] NWS weather.gov — no key needed
# [NO-AUTH] FEMA OpenFEMA — no key needed
# [NO-AUTH] USGS earthquakes — no key needed
# [NO-AUTH] SEPTA API — no key needed (TransitView, TrainView, alerts, bus detours)
# [NO-AUTH] Indego GBFS — no key needed (bcycle_indego)
# [NO-AUTH] OpenDataPhilly Carto SQL — no key needed (phl.carto.com)
# [NO-AUTH] PennDOT ArcGIS camera locations — no key needed (live video needs 511PA key)

# Purdue CAM2 camera database [FREE, registration] — optional; API host often offline
# Register app at https://www.cam2project.net/ — terms prohibit identifying individuals in video
# CAM2_CLIENT_ID=
# CAM2_CLIENT_SECRET=
# [NO-AUTH] Iowa State NEXRAD WMTS — no key needed
# [NO-AUTH] NDBC NOAA buoys — no key needed
# [NO-AUTH] EPA Envirofacts — no key needed
# [NO-AUTH] iNaturalist — no key needed
# [NO-AUTH] Wikipedia GeoSearch — no key needed
# [NO-AUTH] Panoramax — no key needed
# [NO-AUTH] GOES-16/18 AWS S3 — no key needed (public bucket)
# [NO-AUTH] NASA EPIC — no key needed
# [NO-AUTH] FAA TFR XML — no key needed
# [NO-AUTH] aviationweather.gov METARs/PIREPs — no key needed

# ─── Application Config ───────────────────────────────────────────────────────

# FastAPI settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Default bounding box for discovery (Philadelphia metro area)
DEFAULT_LAT=39.9526
DEFAULT_LON=-75.1652
DEFAULT_RADIUS_KM=25

# Max WebSocket clients
MAX_WS_CLIENTS=100

# Cesium Ion access token [FREE] — ion.cesium.com → Access Tokens
# Enables World Terrain + OSM 3D Buildings in the frontend (Vite exposes as VITE_*).
# VITE_CESIUM_ION_ACCESS_TOKEN=
