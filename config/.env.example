# GRIDLAND Environment Variables
# Copy to .env and fill in values. Never commit .env.
# All variables marked [FREE] have free registration tiers.
# All variables marked [NO-AUTH] require no registration.
# Variables marked [V2] are not used in v1 but documented for future use.

# ─── Discovery APIs ───────────────────────────────────────────────────────────

# Mapillary API key [FREE] — Register at mapillary.com/app/settings/developers
# Used for the photosphere transition on /api/photospheres
MAPILLARY_API_KEY=

# WSDOT (Washington State DOT) HighwayCameras key [FREE] — wsdot.wa.gov/traffic/api/
WSDOT_API_KEY=

# 511NY (NYSDOT) cameras key [FREE] — 511ny.org/developers
N511NY_API_KEY=

# GreyNoise Community API key [FREE] — Register at greynoise.io/plans/community
GREYNOISE_API_KEY=

# [NO-AUTH] FCC ASR — no key needed
# [NO-AUTH] OSM Overpass — no key needed
# [NO-AUTH] ARIN RDAP — no key needed
# [NO-AUTH] crt.sh — no key needed
# [NO-AUTH] Wayback CDX — no key needed

# [V2] Shodan API key — $49/mo at shodan.io
# SHODAN_API_KEY=

# [V2] Censys API key — free 250 queries/mo at censys.io
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# ─── Real-Time Feeds ──────────────────────────────────────────────────────────

# OpenSky Network — anonymous is 400 req/day. Register free at opensky-network.org
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AISHub research key [FREE] — Register at aishub.net/register
AISHUB_USERNAME=

# aprs.fi API key [FREE] — Register at aprs.fi/page/api
APRS_FI_API_KEY=

# N2YO API key [FREE] — Register at n2yo.com/api/
N2YO_API_KEY=

# [NO-AUTH] ADSB.fi — no key needed
# [NO-AUTH] Celestrak TLEs — no key needed
# [NO-AUTH] Blitzortung (relay required) — no key needed

# ─── Contextual APIs ─────────────────────────────────────────────────────────

# OpenWeatherMap [FREE] — Register at openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# OpenAQ [FREE] — Register at openaq.org
OPENAQ_API_KEY=

# NASA FIRMS fire data [FREE] — Register at firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# Transitland v2 [FREE] — Register at transit.land/api
TRANSITLAND_API_KEY=

# MTA NYC [FREE] — Register at api.mta.info
MTA_API_KEY=

# Mapillary (reuse from discovery)
# MAPILLARY_API_KEY= (set above)

# KartaView [FREE] — Register at kartaview.org
KARTAVIEW_ACCESS_TOKEN=

# [NO-AUTH] NWS weather.gov — no key needed
# [NO-AUTH] FEMA OpenFEMA — no key needed
# [NO-AUTH] USGS earthquakes — no key needed
# [NO-AUTH] SEPTA API — no key needed
# [NO-AUTH] Iowa State NEXRAD WMTS — no key needed
# [NO-AUTH] NDBC NOAA buoys — no key needed
# [NO-AUTH] EPA Envirofacts — no key needed
# [NO-AUTH] iNaturalist — no key needed
# [NO-AUTH] Wikipedia GeoSearch — no key needed
# [NO-AUTH] Panoramax — no key needed
# [NO-AUTH] GOES-16/18 AWS S3 — no key needed (public bucket)
# [NO-AUTH] NASA EPIC — no key needed
# [NO-AUTH] FAA TFR XML — no key needed
# [NO-AUTH] aviationweather.gov METARs/PIREPs — no key needed

# ─── Application Config ───────────────────────────────────────────────────────

# FastAPI settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Default bounding box for discovery (Philadelphia metro area)
DEFAULT_LAT=39.9526
DEFAULT_LON=-75.1652
DEFAULT_RADIUS_KM=25

# Max WebSocket clients
MAX_WS_CLIENTS=100

# [V2] Cesium Ion access token — register free at ion.cesium.com
# CESIUM_ION_TOKEN=
